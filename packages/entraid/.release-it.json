{
  "npm": {
    "publish": true,
    "skipChecks": true,
    "tag": "maintenance-v5",
    "publishArgs": ["--access", "public"]
  },
  "git": {
    "tagName": "entraid@${version}",
    "tagMatch": "entraid@*",
    "commitMessage": "Release ${tagName}",
    "tagAnnotation": "Release ${tagName}",
    "commitArgs": "--all"
  },
  "plugins": {
    "@release-it/bumper": {
      "out": {
        "file": "package.json",
        "path": ["peerDependencies.@redis/client"],
        "versionPrefix": "^"
      }
    }
  }
}
